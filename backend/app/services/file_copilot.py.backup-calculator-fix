"""
File & Folder Copilot service for TERMIQ V2.0.

Provides:
- Natural-language parsing of file/folder/project requests
- Clarification questions when essential parameters are missing
- Predefined project templates (Python, HTML/CSS/JS, Markdown docs)
- Content generation via Gemini with rule-based fallback
- Approval token binding (task_id, target_path, content_hash)
- One-time consumption, short TTL expiry, and conflict detection
- Safe multi-file project creation with per-file status reporting
- Full audit logging without logging secrets or file contents
"""

import json
import logging
import os
import re
import threading
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Optional
from uuid import uuid4

from dotenv import load_dotenv

from app.models import (
    AuditEntry,
    FileOperationType,
    FileTask,
    FileTaskStatus,
    PlannedFile,
    ProjectTemplate,
)
from app.services.file_security import (
    compute_content_hash,
    get_approved_roots,
    is_safe_filename,
    safe_create_file,
    safe_create_folder,
    validate_path,
)

logger = logging.getLogger(__name__)

# Approval TTL (5 minutes)
APPROVAL_TTL_SECONDS = 300

# In-memory store for active file tasks and audit trail
_file_tasks: dict[str, FileTask] = {}
_file_audit_log: list[AuditEntry] = []
_file_lock = threading.Lock()


# ── Audit helpers ──────────────────────────────────────────────────────

def _file_audit(event: str, task_id: str = "", detail: str = "") -> None:
    entry = AuditEntry(
        event=f"FILE_{event}",
        plan_id=task_id,
        action_id="",
        detail=detail,
    )
    with _file_lock:
        _file_audit_log.append(entry)
    logger.info("AUDIT FILE_%s task=%s %s", event, task_id, detail)


def get_file_audit_log() -> list[dict]:
    with _file_lock:
        return [e.model_dump(mode="json") for e in _file_audit_log]


